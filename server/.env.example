PORT=5000
HOST=127.0.0.1
NODE_ENV=development
# Browser origin allowed to call the API with credentials.
CLIENT_ORIGIN=http://localhost:5173
# memory = accounts and sessions reset on restart; mongo = persistent.
STORAGE_DRIVER=memory
MONGO_URI=mongodb://127.0.0.1:27017/restaurant_reservation
# Required in production (32+ chars). Leave blank in development.
JWT_SECRET=
SESSION_SECONDS=28800
AUTH_RATE_LIMIT=30
# Seeds the first administrator on first start only. Never signs anyone in.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEFAULT_DURATION_MINUTES=90
MAX_DURATION_MINUTES=240
MAX_ADVANCE_DAYS=90
