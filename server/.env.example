# Copy to server/.env and fill in private values. Never commit server/.env.

# Server (Render: HOST=0.0.0.0, NODE_ENV=production; PORT is provided by Render).
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# Exact frontend origin; use your Vercel URL when deployed (no trailing slash).
CLIENT_ORIGIN=http://localhost:5173

# Persistent MongoDB Atlas storage. Paste your Atlas connection string below.
# Include a database name and URL-encode special characters in credentials.
STORAGE_DRIVER=mongo
MONGODB_URI=

# Sessions. Set a stable, random secret of at least 32 characters in production.
# Blank in development generates a new secret on each server restart.
JWT_SECRET=
SESSION_SECONDS=28800
# Maximum authentication attempts per IP per 15 minutes.
AUTH_RATE_LIMIT=30

# Optional: seed the first administrator if none exists, then remove credentials.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Reservation limits (durations in minutes).
DEFAULT_DURATION_MINUTES=90
MAX_DURATION_MINUTES=240
MAX_ADVANCE_DAYS=90
